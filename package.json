{
  "name": "lex",
  "version": "1.7.15",
  "description": "Sistema de Gestión de Casos Jurídicos - LexConsilium Consultores",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "node node_modules/electron-builder/out/cli/cli.js --win",
    "dist:portable": "node node_modules/electron-builder/out/cli/cli.js --win portable",
    "dist:publish": "node node_modules/electron-builder/out/cli/cli.js --win --publish always"
  },
  "author": "LexConsilium Consultores",
  "license": "ISC",
  "build": {
    "forceCodeSigning": false,
    "appId": "com.cmr.lex",
    "productName": "LEX - Gestión Jurídica",
    "directories": {
      "output": "dist_instalador"
    },
    "files": [
      "main.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "supabase/**/*",
      "build/**/*",
      "node_modules/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "lexconsiliumconsultores",
      "repo": "lex",
      "private": true,
      "releaseType": "release"
    },
    "win": {
      "signExecutable": false,
      "artifactName": "lex-setup-${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "lex-portable-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "installerHeaderIcon": "build/icon.png",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LEX"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.116.0",
    "electron-updater": "^6.3.9",
    "nodemailer": "^9.0.6",
    "pg": "^8.23.0",
    "sql.js": "^1.10.0"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^26.0.12",
    "sharp": "^0.35.4"
  }
}
